# Fase 2 — Auth + base de datos real.
#
# Connection string de tu base de datos Postgres (Neon, por ejemplo). Cópiala
# desde el dashboard de Neon ("Connection string", modo "Pooled connection")
# y pégala en un archivo .env.local (nunca en este .env.example, y nunca la
# subas a un repositorio compartido).
DATABASE_URL="postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/alliance_crm?sslmode=require"

# Connection string DIRECTA (sin el pooler de Neon/PgBouncer) al mismo
# Postgres — misma URL que arriba pero sin "-pooler" en el host. Prisma la
# necesita SOLO para correr migraciones (`prisma migrate`): el advisory
# lock que usa para coordinarlas no funciona sobre una conexión pooled. La
# app en sí (DATABASE_URL) sigue usando siempre la pooled.
DIRECT_URL="postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/alliance_crm?sslmode=require"

# No se usa NextAuth/Auth.js — las sesiones se manejan directo en base de
# datos (tabla Session) para poder revocar el acceso de un usuario al
# instante desde Configuración → Usuarios, sin depender de un token firmado
# con expiración propia. Por eso no hace falta ningún secreto aquí.

# Correo interno — dominio usado para generar las direcciones
# usuario@<dominio> de cada buzón (Configuración → Comunicación → Correo
# interno). 100% privado: nunca se usa para enviar correo a internet, así
# que puede ser cualquier texto, real o inventado — solo evita terminar en
# .local/.localhost/.test/.invalid/.example (reservados por el sistema
# operativo). Cambiarlo después NO reescribe las direcciones ya emitidas
# (cada buzón guarda el dominio con el que se creó).
INTERNAL_EMAIL_DOMAIN="alliance.internal"

# Fase 4 — clave de cifrado AES-256-GCM (32 bytes en hexadecimal, 64
# caracteres) para los datos sensibles de clientes (SSN, cuentas bancarias,
# routing numbers...) guardados en SensitiveField.encryptedValue — ver
# src/lib/sensitiveData.ts. Es un secreto real: NUNCA la pongas acá con un
# valor de verdad, solo en tu .env.local. Generar una nueva con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cambiarla después (o perderla) vuelve ilegible cualquier dato sensible ya
# cifrado con la clave anterior — no hay forma de recuperarlo.
SENSITIVE_DATA_ENCRYPTION_KEY="<genera la tuya, no copies esta línea>"

# Opcional — identidad de la cuenta Super Admin que crea `npm run db:seed`
# la primera vez. Si no se define, usa un valor por defecto fijo en el
# código (ver prisma/seed.ts) — solo hace falta definir esto si vas a
# desplegar una instancia nueva y quieres tu propio Super Admin desde el
# primer seed, sin editar el código.
SUPER_ADMIN_EMAIL="tu-correo@ejemplo.com"
SUPER_ADMIN_FIRST_NAME="Nombre"
SUPER_ADMIN_LAST_NAME="Apellido"
