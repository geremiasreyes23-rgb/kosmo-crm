// ---------------------------------------------------------------------------
// 11. RECONOCIMIENTOS — sección "Perfil de usuario"
// ---------------------------------------------------------------------------
// Insignias que un usuario le envía a otro (o el sistema le da de
// bienvenida — ver prisma/seed.ts). Modelo intencionalmente simple: el tipo
// determina el ícono/color/etiqueta en el frontend (ver
// src/components/profile/recognitionTypes.ts), así que agregar un tipo nuevo
// no requiere migración, solo un valor de enum + una entrada en ese catálogo.
model Recognition {
  id     String          @id @default(cuid())
  type   RecognitionType
  note   String?
  createdAt DateTime     @default(now())

  toUserId   String
  toUser     User   @relation("RecognitionTo", fields: [toUserId], references: [id])
  fromUserId String
  fromUser   User   @relation("RecognitionFrom", fields: [fromUserId], references: [id])

  @@index([toUserId])
}

enum RecognitionType {
  PERFORMANCE
  LEADERSHIP
  EXCELLENCE
  GOALS
  TEAMWORK
  MENTOR
  MILESTONE
  GRATITUDE
}

// ---------------------------------------------------------------------------
// 12. MENSAJERÍA INTERNA — chat 1:1 entre usuarios de KOSMO
// ---------------------------------------------------------------------------
// Reemplaza el shell de UI con datos ficticios de Fase 1 (src/data/messenger.ts)
// — ahora las conversaciones y mensajes son filas reales, compartidas entre
// todos los usuarios de la plataforma. Sigue siendo 1:1 por ahora (sin chats
// grupales); "todos con todos" — cualquier usuario ACTIVE puede escribirle a
// cualquier otro, sin restricción de jerarquía.
//
// userAId/userBId se guardan siempre normalizados (el id menor en userAId)
// para que el índice único detecte el par sin importar quién inició el chat
// — ver findOrCreateConversation() en app/(app)/messages/actions.ts.
model Conversation {
  id        String   @id @default(cuid())
  userAId   String
  userA     User     @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  messages Message[]
  reads    ConversationRead[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  text           String?
  sticker        String?
  // Foto adjunta embebida como data URL, igual que avatarUrl/coverPhotoUrl de
  // User — sin proveedor de almacenamiento de archivos propio todavía.
  imageUrl       String?
  imageName      String?
  sentAt         DateTime     @default(now())
  // Fase de mensajería — menú contextual estilo Bitrix24 (editar/eliminar/fijar).
  // Editar: solo el remitente, solo el texto (no aplica a stickers). null = nunca editado.
  editedAt       DateTime?
  // Eliminar es un borrado lógico — el texto/imagen dejan de mostrarse ("Mensaje
  // eliminado") pero la fila se conserva. null = no eliminado.
  deletedAt      DateTime?
  // Fijado — un solo mensaje fijado a la vez por conversación (ver
  // togglePinMessageAction, que desfija cualquier otro al fijar uno nuevo).
  pinned         Boolean      @default(false)
  pinnedAt       DateTime?

  @@index([conversationId, sentAt])
  @@index([conversationId, pinned])
}

// Marca de "leído hasta" por usuario y conversación — reemplaza al viejo
// estado por-mensaje simulado (SENT → DELIVERED → READ con setTimeout). Un
// mensaje se pinta como leído cuando su sentAt <= lastReadAt del otro
// participante.
model ConversationRead {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("ConversationReads", fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())

  @@unique([conversationId, userId])
}

// ---------------------------------------------------------------------------
// 15. CORREO INTERNO — mensajería corporativa privada (usuario@<dominio interno>)
// ---------------------------------------------------------------------------
// Correo asíncrono (Para/CC/Asunto/Cuerpo/Adjuntos/Carpetas) 100% privado —
// deliberadamente SEPARADO de la Mensajería interna de la sección 12 (chat
// 1:1 en vivo tipo WhatsApp): acá el modelo es Outlook/Gmail cerrado a la
// organización, no chat en tiempo real.
//
// Reglas de diseño que este bloque encierra (ver brief del usuario):
// - NUNCA se conecta a internet público: no hay SMTP saliente/entrante, no
//   hay envío a Gmail/Outlook/Yahoo. Un InternalMessageRecipient solo puede
//   apuntar a un InternalMailbox que ya existe en esta base de datos — el
//   propio tipo del modelo hace estructuralmente imposible el envío externo,
//   no es solo una validación en el formulario.
// - El dominio (ej. "alliance.internal") es una variable de entorno
//   (INTERNAL_EMAIL_DOMAIN, ver src/lib/mail/config.ts), no una columna en
//   cada fila — así se puede migrar a un dominio real después sin tocar
//   millones de direcciones ya emitidas. Cada buzón sí guarda
//   `domainAtCreation` para reconstruir la dirección con la que se creó.
// - user_id (nunca el email) es la llave primaria de identidad — igual que
//   el resto del CRM: InternalMailbox.userId es único y es lo que enlaza
//   todo lo demás.
// - Cada destinatario tiene su PROPIA copia del mensaje
//   (InternalMessageRecipient) en su propia carpeta — así archivar/leer/
//   borrar el correo de una persona nunca afecta la copia de otra, incluida
//   la del remitente (su copia en "Enviados" es una fila con role=FROM).
// - Papelera y retención son borrado LÓGICO (isDeleted) — nunca se borra la
//   fila físicamente salvo por el job de retención (ver MailSettings.
//   retentionPolicy) o una eliminación explícita desde la Papelera.
// - MailAuditLog es de solo-anexado desde la aplicación: ninguna acción de
//   servidor expuesta a usuarios normales actualiza ni borra estas filas.

model InternalMailbox {
  id               String        @id @default(cuid())
  userId           String        @unique
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Dirección = `${localPart}@${domainAtCreation}` — nunca se recalcula con
  // el dominio "actual" para una fila ya emitida (ver nota de la sección).
  localPart        String
  domainAtCreation String
  status           MailboxStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  disabledAt       DateTime?

  folders      MailFolder[]
  recipients   InternalMessageRecipient[]
  sentMessages InternalMessage[]          @relation("MailSender")
  auditLogs    MailAuditLog[]

  @@unique([localPart, domainAtCreation])
}

enum MailboxStatus {
  ACTIVE
  // Usuario desactivado/eliminado — el buzón NO se borra ni se libera la
  // dirección de inmediato (retención + evita reasignar la misma dirección
  // a otra persona por error), ver deleteUserAction / setUserStatusAction.
  DISABLED
  ARCHIVED
}

model MailFolder {
  id        String         @id @default(cuid())
  mailboxId String
  mailbox   InternalMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  type      MailFolderType
  // Etiqueta visible — para carpetas de sistema la fija el catálogo del
  // frontend (src/lib/mail/folders.ts) al crearlas; editable solo si
  // type = CUSTOM (futuras carpetas propias del usuario).
  name      String
  isSystem  Boolean        @default(true)
  order     Int            @default(0)
  createdAt DateTime       @default(now())

  recipients InternalMessageRecipient[]

  @@unique([mailboxId, type, name])
  @@index([mailboxId])
}

enum MailFolderType {
  INBOX
  SENT
  DRAFTS
  ARCHIVE
  TRASH
  CUSTOM
}

model InternalMessage {
  id        String          @id @default(cuid())
  senderId  String
  sender    InternalMailbox @relation("MailSender", fields: [senderId], references: [id])
  subject   String
  body      String          @db.Text
  isDraft   Boolean         @default(false)
  // Direcciones tal como se escribieron en el compositor MIENTRAS el mensaje
  // es borrador — todavía no se resolvieron a filas InternalMessageRecipient
  // reales (eso solo pasa al enviar, cuando cada destinatario ya se validó
  // como interno y activo). Se conservan también después de enviado, como
  // registro legible de a quién se escribió sin tener que unir recipients.
  draftToAddresses String[]   @default([])
  draftCcAddresses String[]   @default([])
  sentAt    DateTime?
  createdAt DateTime        @default(now())

  recipients  InternalMessageRecipient[]
  attachments InternalAttachment[]

  @@index([senderId, createdAt])
}

model InternalMessageRecipient {
  id            String          @id @default(cuid())
  messageId     String
  message       InternalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mailboxId     String
  mailbox       InternalMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  folderId      String
  folder        MailFolder      @relation(fields: [folderId], references: [id])
  recipientRole MailRecipientRole
  isRead        Boolean         @default(false)
  readAt        DateTime?
  // Papelera lógica — ver nota de la sección.
  isDeleted     Boolean         @default(false)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())

  @@index([mailboxId, folderId])
  @@index([messageId])
}

enum MailRecipientRole {
  TO
  CC
  // Copia del propio remitente en su carpeta "Enviados".
  FROM
}

model InternalAttachment {
  id        String          @id @default(cuid())
  messageId String
  message   InternalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  sizeBytes Int
  // Mismo patrón que Message.imageUrl / User.avatarUrl — base64 embebido
  // directo en Postgres, único almacenamiento de archivos que existe hoy en
  // este CRM (no hay proveedor de object storage contratado).
  dataUrl    String          @db.Text
  uploadedAt DateTime        @default(now())

  @@index([messageId])
}

// Auditoría DEDICADA de correo — separada de AuditLog (sección 14) porque el
// brief exige ip/userAgent (AuditLog no los tiene) y exige que sea de
// solo-anexado, nunca modificable por un usuario normal.
model MailAuditLog {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  mailboxId    String?
  mailbox      InternalMailbox? @relation(fields: [mailboxId], references: [id])
  action       MailAuditAction
  messageId    String?
  attachmentId String?
  ipAddress    String?
  userAgent    String?
  // Contexto adicional sin esquema fijo — ej. { reason, targetMailboxId }
  // para un ADMIN_ACCESS_GRANTED (acceso excepcional de un admin al buzón de
  // otro usuario, siempre con motivo registrado, nunca automático).
  metadata     Json?
  createdAt    DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([mailboxId, createdAt])
}

enum MailAuditAction {
  MESSAGE_CREATED
  MESSAGE_SENT
  MESSAGE_READ
  MESSAGE_DELETED
  MESSAGE_ARCHIVED
  ATTACHMENT_UPLOADED
  ATTACHMENT_DOWNLOADED
  ATTACHMENT_DELETED
  MAILBOX_ACCESSED
  EXTERNAL_RECIPIENT_BLOCKED
  // Acceso excepcional de un Admin al buzón de otro usuario — siempre con
  // `metadata.reason`, nunca implícito por el rol (ver brief: "ni siquiera
  // los administradores deberían tener acceso automático").
  ADMIN_ACCESS_GRANTED
}

// Configuración global del módulo, editable en caliente desde Configuración →
// Comunicación → Correo interno, sin redeploy. El dominio real sigue viviendo
// en la variable de entorno INTERNAL_EMAIL_DOMAIN (fuente de verdad para
// generar direcciones nuevas) — esta fila es lo que un Admin puede ajustar:
// activar/desactivar el módulo entero y los límites de adjuntos/retención.
model MailSettings {
  id                  String              @id @default("singleton")
  isEnabled           Boolean             @default(true)
  maxAttachmentSizeMb Int                 @default(10)
  allowedExtensions   String[]            @default(["pdf", "png", "jpg", "jpeg", "docx", "xlsx"])
  retentionPolicy     MailRetentionPolicy @default(INDEFINITE)
  updatedAt           DateTime            @updatedAt
}

enum MailRetentionPolicy {
  DAYS_30
  DAYS_90
  YEAR_1
  INDEFINITE
}
