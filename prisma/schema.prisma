// ============================================================================
// Alliance Insurance CRM — Modelo de datos (Fase 1)
// ============================================================================
// Este schema es el CONTRATO de datos del sistema. No se conecta todavía a una
// base de datos real (eso ocurre en Fase 2, junto con Auth). Se entrega ahora
// para validar el modelo relacional antes de escribir código de backend.
//
// Principios de diseño:
// 1. Lead / Client / Policy / Commission son entidades separadas (nunca una
//    tabla gigante de "clientes" con 200 columnas).
// 2. Cada línea de negocio (Medicare, Obamacare, Family Heritage) tiene su
//    propia tabla de perfil 1:1 con Client — así una línea nueva (Vida,
//    Dental, ...) se agrega como tabla nueva sin tocar Client.
// 3. Nada de catálogos hardcodeados: LeadSource, Pipeline, PipelineStage,
//    InsuranceLine, Carrier, CommissionRate, CustomField son configurables
//    desde el módulo de Configuración.
// 4. Todo cambio de etapa, de vendedor o acceso a datos sensibles queda
//    trazado (PipelineHistory, AuditLog, SensitiveDataAccessLog).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 1. USUARIOS, ROLES Y PERMISOS (RBAC)
// ---------------------------------------------------------------------------

model User {
  id                  String   @id @default(cuid())
  firstName           String
  lastName             String
  email                String   @unique
  passwordHash         String
  // Obliga a cambiar la contraseña en el próximo login — se activa al crear
  // el usuario con contraseña temporal o al restablecerla desde Configuración.
  mustChangePassword   Boolean  @default(true)
  roleId               String
  role                 Role     @relation(fields: [roleId], references: [id])
  agentId              String?  @unique
  agent                Agent?   @relation(fields: [agentId], references: [id])
  status               UserStatus @default(ACTIVE)
  lastLoginAt          DateTime?
  // Perfil personal — lo edita cada usuario desde "Mi perfil" (no requiere
  // permiso de Admin, a diferencia de nombre/correo/rol que sí lo requieren).
  avatarUrl            String?  // data URL (imagen embebida) o URL externa
  phone                String?
  jobTitle             String?  // cargo, texto libre — no reemplaza Role
  birthday             DateTime? @db.Date
  // Ficha de perfil (sección "Perfil de usuario") — opcionales a propósito:
  // hoy nadie los llena todavía (no hay UI de edición para ellos aún, solo
  // de lectura), así que la página de perfil los muestra como "No
  // especificado" hasta que se conecte un formulario/admin que los cargue.
  coverPhotoUrl        String?  // banner del perfil — data URL, igual que avatarUrl
  department           String?
  city                 String?
  phoneExtension       String?
  notificationLanguage String?
  workFormat           String?  // ej. "Remoto", "Híbrido", "Presencial" — texto libre por ahora
  supervisorId         String?
  supervisor           User?    @relation("UserSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  directReports        User[]   @relation("UserSupervisor")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  sessions              Session[]
  timeEntries           TimeEntry[]
  tasksAssigned         Task[]
  activities            Activity[]
  dailyReports          DailyReport[] @relation("DailyReportAuthor")
  dailyReportsReviewed  DailyReport[] @relation("DailyReportReviewer")
  appointments          Appointment[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  sensitiveAccessLog    SensitiveDataAccessLog[]
  documentsUploaded     Document[]
  recognitionsReceived  Recognition[] @relation("RecognitionTo")
  recognitionsGiven     Recognition[] @relation("RecognitionFrom")

  conversationsAsA      Conversation[] @relation("ConversationUserA")
  conversationsAsB      Conversation[] @relation("ConversationUserB")
  messagesSent          Message[]      @relation("MessagesSent")
  conversationReads     ConversationRead[] @relation("ConversationReads")

  // Correo interno (sección 15) — un usuario tiene a lo sumo un buzón, creado
  // automáticamente al crearse el usuario (ver ensureMailboxForUser en
  // src/lib/mail/mailbox.ts, también usado como backfill perezoso para
  // cuentas que ya existían antes de esta migración).
  internalMailbox InternalMailbox?
  mailAuditLogs   MailAuditLog[]
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// Sesiones en base de datos (no JWT stateless) — a propósito, para que un
// Admin pueda revocar el acceso de un usuario al instante desde
// Configuración → Usuarios (clave para un call center con personal
// rotativo): borrar esta fila (o desactivar al usuario) invalida la sesión
// de inmediato, sin esperar a que expire un token firmado.
model Session {
  id        String   @id // token opaco (no es un JWT, solo una clave de búsqueda)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
}

// Fichaje / cronómetro personal ("En el trabajo") — cada fila es una jornada:
// se abre al marcar "Iniciar", se puede pausar/reanudar (el tiempo en pausa
// no cuenta como trabajado) y se cierra al marcar "Finalizar". Por ahora es
// solo el cronómetro individual visible en el menú del usuario — reportes de
// asistencia para Admin quedan para una fase de Reportes más adelante.
model TimeEntry {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  clockIn            DateTime        @default(now())
  clockOut           DateTime?
  status             TimeEntryStatus @default(WORKING)
  pausedAt           DateTime?       // inicio de la pausa actual, null si no está en pausa
  totalPausedSeconds Int             @default(0) // acumulado de pausas ya cerradas en esta jornada
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([userId, status])
}

enum TimeEntryStatus {
  WORKING
  PAUSED
  FINISHED
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique // Super Admin, Admin, Manager, Agent, Viewer
  description String?
  isSystem    Boolean      @default(false) // roles base no eliminables
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime     @default(now())
}

model Permission {
  id       String @id @default(cuid())
  resource String // "leads", "commissions", "sensitive_data", ...
  action   String // "view", "create", "edit", "delete", "export"
  roles    RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// ---------------------------------------------------------------------------
// 2. AGENTES / VENDEDORES / AOR
// ---------------------------------------------------------------------------
// Un Agent puede actuar como vendedor, como AOR, o ambos — se modela con
// flags en lugar de tablas separadas para no duplicar personas.

model Agent {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  npn          String?  @unique // National Producer Number
  email        String?
  phone        String?
  isSeller     Boolean  @default(true)
  isAor        Boolean  @default(false)
  status       AgentStatus @default(ACTIVE)
  user         User?
  createdAt    DateTime @default(now())

  leadsAsAgent     Lead[]     @relation("LeadAgent")
  leadsAsAor       Lead[]     @relation("LeadAor")
  clientsAsAgent   Client[]   @relation("ClientAgent")
  clientsAsAor     Client[]   @relation("ClientAor")
  policiesAsAgent  Policy[]   @relation("PolicyAgent")
  policiesAsAor    Policy[]   @relation("PolicyAor")
  sales            Sale[]
  commissionRates  CommissionRate[]
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// 3. CATÁLOGOS CONFIGURABLES
// ---------------------------------------------------------------------------

model LeadSource {
  id    String @id @default(cuid())
  name  String @unique // Base de datos, Referido, Evento, Llamada entrante, Otro
  leads Lead[]
}

model InsuranceLine {
  id          String   @id @default(cuid())
  name        String   @unique // Medicare Advantage, Obamacare, Family Heritage, Vida...
  code        String   @unique // MEDICARE, OBAMACARE, FAMILY_HERITAGE, VIDA...
  isActive    Boolean  @default(true)
  carriers    CarrierInsuranceLine[]
  policies    Policy[]
  sales       Sale[]
  rates       CommissionRate[]
  customFields CustomField[] @relation("LineCustomFields")
  leadsInterested Lead[] @relation("LeadInterestedLine")
}

model Carrier {
  id       String   @id @default(cuid())
  name     String   @unique
  status   CarrierStatus @default(ACTIVE)
  lines    CarrierInsuranceLine[]
  policies Policy[]
  sales    Sale[]
}

enum CarrierStatus {
  ACTIVE
  INACTIVE
}

model CarrierInsuranceLine {
  carrierId       String
  insuranceLineId String
  carrier         Carrier       @relation(fields: [carrierId], references: [id])
  insuranceLine   InsuranceLine @relation(fields: [insuranceLineId], references: [id])

  @@id([carrierId, insuranceLineId])
}

// ---------------------------------------------------------------------------
// 4. PIPELINES Y ETAPAS (configurable, aplica a Lead y a Sale)
// ---------------------------------------------------------------------------

model Pipeline {
  id         String          @id @default(cuid())
  name       String
  entityType PipelineEntity  // LEAD | SALE
  isDefault  Boolean         @default(false)
  stages     PipelineStage[]
  leads      Lead[]
  sales      Sale[]
}

enum PipelineEntity {
  LEAD
  SALE
}

model PipelineStage {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])
  name       String
  order      Int
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)
  leads      Lead[]
  sales      Sale[]

  @@unique([pipelineId, order])
}

// Historial de cambio de etapa — aplica tanto a Lead como a Sale (polimórfico)
model PipelineHistory {
  id           String     @id @default(cuid())
  entityType   PipelineEntity
  entityId     String
  fromStageId  String?
  toStageId    String
  changedById  String
  changedAt    DateTime   @default(now())

  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// 5. LEADS
// ---------------------------------------------------------------------------

model Lead {
  id              String        @id @default(cuid())
  firstName       String
  lastName        String
  dob             DateTime?
  phone           String?
  email           String?
  address         String?
  zipCode         String?
  county          String?
  state           String?
  preferredLanguage String?
  sourceId        String?
  source          LeadSource?   @relation(fields: [sourceId], references: [id])
  // Línea de negocio de interés — señal comercial temprana, antes de que
  // exista una Policy real. Es una FK al catálogo InsuranceLine (nunca un
  // enum fijo), así una línea nueva agregada desde Configuración aparece
  // aquí también sin tocar este modelo.
  interestedLineId String?
  interestedLine   InsuranceLine? @relation("LeadInterestedLine", fields: [interestedLineId], references: [id])
  agentId         String?
  agent           Agent?        @relation("LeadAgent", fields: [agentId], references: [id])
  aorId           String?
  aor             Agent?        @relation("LeadAor", fields: [aorId], references: [id])
  pipelineId      String
  pipeline        Pipeline      @relation(fields: [pipelineId], references: [id])
  stageId         String
  stage           PipelineStage @relation(fields: [stageId], references: [id])
  lastContactAt   DateTime?
  nextFollowUpAt  DateTime?
  convertedAt     DateTime?
  convertedClientId String?     @unique
  convertedClient Client?       @relation(fields: [convertedClientId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  activities   Activity[]
  tasks        Task[]
  appointments Appointment[]
  documents    Document[]
  notes        Note[]
  sales        Sale[]
  customFieldValues CustomFieldValue[]

  @@index([stageId])
  @@index([agentId])
}

// ---------------------------------------------------------------------------
// 6. CLIENTES
// ---------------------------------------------------------------------------

model Client {
  id                String   @id @default(cuid())
  originLead        Lead?
  firstName         String
  lastName          String
  dob               DateTime?
  phone             String?
  email             String?
  address           String?
  zipCode           String?
  county            String?
  state             String?
  preferredLanguage String?
  sourceId          String?
  agentId           String?
  agent             Agent?   @relation("ClientAgent", fields: [agentId], references: [id])
  aorId             String?
  aor               Agent?   @relation("ClientAor", fields: [aorId], references: [id])
  createdAt         DateTime @default(now()) // "cliente desde"
  updatedAt         DateTime @updatedAt

  policies          Policy[]
  sales             Sale[]
  activities        Activity[]
  tasks             Task[]
  appointments      Appointment[]
  documents         Document[]
  notes             Note[]
  customFieldValues CustomFieldValue[]

  medicareProfile       MedicareProfile?
  obamacareProfile      ObamacareProfile?
  familyHeritageProfile FamilyHeritageProfile?

  sensitiveFields   SensitiveField[]
}

// ---------------------------------------------------------------------------
// 7. DATOS SENSIBLES (genérico, con auditoría de acceso)
// ---------------------------------------------------------------------------
// En vez de columnas de texto plano (SSN, cuentas bancarias) regadas por todo
// el schema, se centralizan aquí: valor cifrado a nivel de aplicación +
// máscara para mostrar en UI + registro de quién accede a los datos reales.

model SensitiveField {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  fieldKey      String   // "ssn", "bank_account_number", "routing_number"...
  encryptedValue String  // cifrado en reposo (AES-256), nunca texto plano
  maskedPreview String   // ej. "***-**-1234", se puede mostrar sin permiso especial
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accessLogs SensitiveDataAccessLog[]

  @@unique([clientId, fieldKey])
}

model SensitiveDataAccessLog {
  id               String         @id @default(cuid())
  sensitiveFieldId String
  sensitiveField   SensitiveField @relation(fields: [sensitiveFieldId], references: [id])
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  reason           String?
  accessedAt       DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// 8. PERFILES POR LÍNEA DE NEGOCIO (1:1 con Client)
// ---------------------------------------------------------------------------

model MedicareProfile {
  id                    String   @id @default(cuid())
  clientId              String   @unique
  client                Client   @relation(fields: [clientId], references: [id])

  medicareNumberRef     String?  // referencia a SensitiveField.id (SSN-like)
  hasMedicaid           Boolean  @default(false)
  medicaidNumberRef     String?
  dualClassification    String?
  qmb                   Boolean  @default(false)
  fbde                  Boolean  @default(false)
  slmb                  Boolean  @default(false)
  extraHelp             Boolean  @default(false)

  healthRating          Int?     // 1-10
  weight                Float?
  height                Float?
  homeAttendant         Boolean  @default(false)
  homeAttendantCompany  String?
  hasCancer             Boolean  @default(false)
  onDialysis            Boolean  @default(false)

  primaryDoctorName     String?
  primaryDoctorAddress  String?
  primaryDoctorPhone    String?
  preferredPharmacy     String?

  currentCarrierId      String?
  currentPlanName       String?
  currentPlanType       PlanType?
  offeredCarrierId      String?
  offeredPlanName       String?
  offeredPlanType       PlanType?
  changeReason          String?
  electionPeriod        String?
  presentationMethod    PresentationMethod?

  soaSigned             Boolean  @default(false)
  soaDate               DateTime?
  soaMethod             String?
  callRecordingUrl      String?

  effectiveDate         DateTime?
  confirmationNumber    String?

  poa                   Boolean  @default(false)
  poaFirstName          String?
  poaLastName           String?
  poaAddress            String?
  poaPhone              String?
  poaRelationship       String?

  currentAor            Boolean  @default(false)
  currentAorName        String?
  acceptsAgentChange    Boolean  @default(false)
  acceptsPlanChange     Boolean  @default(false)
  signatureUrl          String?

  conditions   MedicareCondition[]
  medications  MedicareMedication[]
  specialists  MedicareSpecialist[]
}

enum PlanType {
  HMO
  PPO
  D_SNP
  C_SNP
}

enum PresentationMethod {
  PHONE
  IN_PERSON
  VIRTUAL
}

model MedicareCondition {
  id                String          @id @default(cuid())
  medicareProfileId String
  profile           MedicareProfile @relation(fields: [medicareProfileId], references: [id])
  name              String
  isChronic         Boolean         @default(false)
}

model MedicareMedication {
  id                String          @id @default(cuid())
  medicareProfileId String
  profile           MedicareProfile @relation(fields: [medicareProfileId], references: [id])
  name              String
  mg                String?
  frequency         String?
}

model MedicareSpecialist {
  id                String          @id @default(cuid())
  medicareProfileId String
  profile           MedicareProfile @relation(fields: [medicareProfileId], references: [id])
  name              String
  address           String?
  phone             String?
  nextAppointmentAt DateTime?
}

model ObamacareProfile {
  id                      String   @id @default(cuid())
  clientId                String   @unique
  client                  Client   @relation(fields: [clientId], references: [id])

  age                     Int?
  householdIncomeRef      String?  // referencia a SensitiveField (financiero)
  householdSize           Int?
  immigrationStatusRef    String?  // referencia a SensitiveField (restringido)
  maritalStatus           String?
  hasSpouse               Boolean  @default(false)
  filesJointTaxes         Boolean  @default(false)
  hasEmployerCoverage     Boolean  @default(false)

  period                  String?
  carrierId               String?
  planName                String?
  planType                ObamacarePlanType?
  monthlyPremium          Float?
  marketplaceApplicationId String?
  marketplaceConsent      Boolean  @default(false)
  consentDate             DateTime?
  effectiveDate           DateTime?

  dependents Dependent[]
}

enum ObamacarePlanType {
  BRONZE
  SILVER
  GOLD
}

model Dependent {
  id                 String           @id @default(cuid())
  obamacareProfileId String
  profile            ObamacareProfile @relation(fields: [obamacareProfileId], references: [id])
  firstName          String
  lastName           String
  dob                DateTime?
  ssnRef             String?          // referencia a SensitiveField
}

model FamilyHeritageProfile {
  id             String   @id @default(cuid())
  clientId       String   @unique
  client         Client   @relation(fields: [clientId], references: [id])

  planType       FamilyHeritagePlan?
  coverageType   FamilyHeritageCoverage?
  issueAge       Int?
  rop            Boolean  @default(false)
  monthlyPremium Float?
  policyNumber   String?
  effectiveDate  DateTime?

  bankNameRef       String? // referencia a SensitiveField
  accountHolderRef  String?
  accountCityRef    String?
  routingNumberRef  String?
  accountNumberRef  String?
  debitDayOfMonth   Int?

  coveredMembers CoveredMember[]
}

enum FamilyHeritagePlan {
  ELITE_8
  PREFERRED_4
  STANDARD_2
}

enum FamilyHeritageCoverage {
  INDIVIDUAL
  COUPLE
  SINGLE_PARENT
  FAMILY
}

model CoveredMember {
  id                String                 @id @default(cuid())
  profileId         String
  profile           FamilyHeritageProfile  @relation(fields: [profileId], references: [id])
  firstName         String
  lastName          String
  dob               DateTime?
  relationship      String?
  ssnRef            String?                // referencia a SensitiveField
}

// ---------------------------------------------------------------------------
// 9. PÓLIZAS
// ---------------------------------------------------------------------------

model Policy {
  id              String        @id @default(cuid())
  policyNumber    String?       @unique
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  insuranceLineId String
  insuranceLine   InsuranceLine @relation(fields: [insuranceLineId], references: [id])
  carrierId       String
  carrier         Carrier       @relation(fields: [carrierId], references: [id])
  planName        String?
  premium         Float?
  saleDate        DateTime?
  effectiveDate   DateTime?
  status          PolicyStatus  @default(QUOTE)
  agentId         String?
  agent           Agent?        @relation("PolicyAgent", fields: [agentId], references: [id])
  aorId           String?
  aor             Agent?        @relation("PolicyAor", fields: [aorId], references: [id])
  saleId          String?       @unique
  sale            Sale?         @relation(fields: [saleId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  documents   Document[]
  notes       Note[]
  commission  Commission?
  customFieldValues CustomFieldValue[]

  @@index([clientId])
  @@index([status])
}

enum PolicyStatus {
  QUOTE
  APPLICATION
  PENDING
  APPROVED
  ACTIVE
  CANCELLED
  REJECTED
  CHARGEBACK
}

// ---------------------------------------------------------------------------
// 10. VENTAS (Sales Pipeline)
// ---------------------------------------------------------------------------

model Sale {
  id                 String        @id @default(cuid())
  clientId           String?
  client             Client?       @relation(fields: [clientId], references: [id])
  leadId             String?
  lead               Lead?         @relation(fields: [leadId], references: [id])
  agentId            String?
  agent              Agent?        @relation(fields: [agentId], references: [id])
  insuranceLineId    String?
  insuranceLine      InsuranceLine? @relation(fields: [insuranceLineId], references: [id])
  carrierId          String?
  carrier            Carrier?      @relation(fields: [carrierId], references: [id])
  planName           String?
  premium            Float?
  saleDate           DateTime      @default(now())
  effectiveDate      DateTime?
  method             SaleMethod?
  pipelineId         String
  pipeline           Pipeline      @relation(fields: [pipelineId], references: [id])
  stageId            String
  stage              PipelineStage @relation(fields: [stageId], references: [id])
  expectedCommission Float?
  receivedCommission Float?
  margin             Float?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  policy      Policy?
  documents   Document[]
  activities  Activity[]
  customFieldValues CustomFieldValue[]

  @@index([stageId])
}

enum SaleMethod {
  PHONE
  IN_PERSON
  VIRTUAL
  ONLINE
}

// ---------------------------------------------------------------------------
// 11. COMPENSACIONES Y TARIFAS
// ---------------------------------------------------------------------------

model CommissionRate {
  id                String        @id @default(cuid())
  insuranceLineId   String
  insuranceLine     InsuranceLine @relation(fields: [insuranceLineId], references: [id])
  agentId           String?       // null = tarifa base de la línea
  agent             Agent?        @relation(fields: [agentId], references: [id])
  agentAmountOrPct  Float         // monto fijo o % según agentAmountType
  agentAmountType   AmountType    @default(FIXED)
  managerPct        Float?
  aorAmount         Float?
  effectiveFrom     DateTime      @default(now())
  effectiveTo       DateTime?
}

enum AmountType {
  FIXED
  PERCENTAGE
}

model Commission {
  id                   String   @id @default(cuid())
  policyId             String   @unique
  policy               Policy   @relation(fields: [policyId], references: [id])
  agentAmount          Float?
  managerAmount        Float?
  aorAmount            Float?
  totalAcquisitionCost Float?
  carrierCommission    Float?
  margin               Float?
  agentPaymentDate     DateTime?
  carrierPaymentDate   DateTime?
  status               CommissionStatus @default(PENDING)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum CommissionStatus {
  PENDING
  PAID
  CHARGEBACK
}

// ---------------------------------------------------------------------------
// 12. ACTIVIDADES, TAREAS, CITAS, NOTAS, DOCUMENTOS
// ---------------------------------------------------------------------------

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  result     String?
  notes      String?
  occurredAt DateTime     @default(now())
  userId     String
  user       User         @relation(fields: [userId], references: [id])

  leadId   String?
  lead     Lead?  @relation(fields: [leadId], references: [id])
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])
  saleId   String?
  sale     Sale?   @relation(fields: [saleId], references: [id])

  @@index([leadId])
  @@index([clientId])
}

enum ActivityType {
  CALL
  EMAIL
  SMS
  WHATSAPP
  MEETING
  APPOINTMENT
  NOTE
  FOLLOW_UP
  DOCUMENT
  OTHER
}

// Reportes diarios — resumen general de la jornada que cada usuario
// registra al terminar el día (sección "Actividades" del sidebar, distinto
// del log granular de Activity de arriba: llamadas/citas/etc. siguen
// registrándose donde ya se registraban, esto es un resumen de texto
// libre). Una vez creado queda de solo lectura para su autor — el único
// cambio posterior permitido es la revisión de un supervisor/admin
// (status + reviewedBy/reviewedAt/reviewComment), nunca una edición del
// contenido original.
model DailyReport {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation("DailyReportAuthor", fields: [userId], references: [id])
  content String

  status DailyReportStatus @default(PENDING)

  reviewedById  String?
  reviewedBy    User?     @relation("DailyReportReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewComment String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

enum DailyReportStatus {
